# Runtime
NODE_ENV=development
PORT=5000
REQUEST_BODY_LIMIT=2mb
SCHEDULER_POLL_MS=15000
GMAIL_TIMEOUT_MS=20000

# Single-owner authentication
# Configure or reset securely with: npm run setup:owner-auth
OWNER_PASSWORD_HASH=
# Generated and rotated by setup:owner-auth. Do not put this value in the APK.
SESSION_SIGNING_KEY=
SESSION_TTL_SECONDS=43200

# AES-256-GCM key for OAuth and AI secrets.
# setup:owner-auth creates this only when missing. Never rotate it casually.
DATA_ENCRYPTION_KEY=

# Persistence: production requires MongoDB; local/test defaults to JSON.
PERSISTENCE_DRIVER=json
MONGODB_URI=mongodb+srv://pk2453412_db_user:QwIThcjWWwgs53Vm@electrohub.pogjgsf.mongodb.net/
MONGODB_DB_NAME=arclivo
MONGODB_STATE_COLLECTION=app_state

# Comma-separated trusted browser origins. Native Android requests have no browser Origin.
CORS_ORIGINS=https://admin.example.com

# Google OAuth 2.0 Web application credentials. Keep the existing Gmail scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-production-domain.example/api/auth/google/callback

# Vercel Cron authorization (minimum 32 random characters).
CRON_SECRET=

# Tests only: directs JSON persistence to an isolated directory.
# ARCLIVO_DATA_DIR=
